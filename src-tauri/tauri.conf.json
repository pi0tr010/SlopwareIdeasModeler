{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlopwareIdeasModeler",
  "mainBinaryName": "slopware-ideas-modeler",
  "version": "0.1.0",
  "identifier": "dev.slopware.ideasmodeler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlopwareIdeasModeler",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "externalBin": ["binaries/slopware-mcp"],
    "category": "DeveloperTool",
    "shortDescription": "UML and ERD modeler compatible with .simp projects",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
