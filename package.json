{
  "name": "slopware-ideas-modeler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser and offline diagram modeler compatible with .simp projects",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog": "node scripts/generate-catalog.mjs",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --jsx=automatic --outfile=dist-mcp/server.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.23.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
